---
import Site from "../layouts/Site.astro";
import { HOWTO, HOWTO_FLAT, HOWTO_PATH, howtoHref, langOf, t } from "../data/nav.js";
import { howtoMeta } from "../lib/howtos.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const headings = HOWTO.map((g, i) => ({ slug: `g${i}`, text: t(g, "group", lang), depth: 2 }));
const T = en
  ? { h: "How-to: how exactly", p: "One job per article: find the one that matches what you're doing, copy the prompt, change it to fit." }
  : { h: "How-to：具体怎么做", p: "一篇只讲一件事。找到和你手上的活一样的那篇，复制里面的话，改成你的情况就能用。" };
const META = Object.fromEntries(HOWTO_FLAT.map((h) => [h.slug, howtoMeta(h.slug, lang)]));
const first = HOWTO_FLAT.find((h) => h.slug === HOWTO_PATH[0]);
const S = en
  ? { a: "Not sure where to start? Begin with ", b: ". Every article ends by pointing to the next one." }
  : { a: "不知道从哪篇看起，就从", b: "开始。每篇末尾都指好了下一篇。" };
---
<Site title={T.h} headings={headings}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p}</p>
    <p>{S.a}{en ? "" : "「"}<a class="xxd-link" href={howtoHref(first.slug, lang)}>{t(first, "title", lang)}</a>{en ? "" : "」"}{S.b}</p>
    {HOWTO.map((g, i) => (
      <>
        <h2 id={`g${i}`}>{t(g, "group", lang)}</h2>
        <ul class="xxd-list" data-interactive>
          {g.items.map((it) => <li class="xxd-list__item"><a class="xxd-list__main list-link" href={howtoHref(it.slug, lang)}><span class="xxd-list__title">{t(it, "title", lang)}</span><span class="xxd-list__meta">{META[it.slug].tldr}{META[it.slug].time && ` · ${META[it.slug].time}`}</span></a></li>)}
        </ul>
      </>
    ))}
  </article>
</Site>
