---
// 首页：先对没写过代码的新人说话（遇到过的事 → 跟着教程有什么不同 → 三课入门 → 适不适合），
// 最后才是给会写代码的人的一张图和完整教程路线。事实只取 docs/PLAN.md 列的来源。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import Demo from "../components/Demo.astro";
import { LESSONS, lessonHref, STEPS, stepHref, langOf, fullLang, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";

const lang = langOf(Astro.url.pathname);
const ZH = {
  brand: "OpenHands 新手教程",
  h1: "有人推荐你用 OpenHands？从这里开始",
  lead: ["OpenHands 是一个开源的 AI 编程代理：你交代一件事，它自己敲命令、改文件、开 PR，还能按时间自己开工。官方文档是写给工程师的，这份教程用大白话带你装上、用起来，", "不会写代码也能跟着做", "。"],
  cta: ["新手从这里开始", "我会写代码，看完整教程"],
  ctaNote: "新手入门一共三课，大约 30 分钟。",
  painH: "你是不是卡在这里",
  PAIN: [
    "打开官方文档，满屏是 npm、Docker、uv，还没开始就不知道该装哪个。",
    "Agent Canvas、Agent Server、后端、ACP、Cloud、SDK，名字一大堆，分不清哪个是给你用的。",
    "听说它会自己改文件、跑命令，又怕它把电脑上别的东西弄乱。",
    "不知道要花多少钱，要不要先去各家开一堆账号。",
  ],
  diffH: "跟着这份教程，有什么不一样",
  diffW: "卡在哪", diffA: "自己啃官方文档", diffB: "跟着这份教程",
  DIFF: [
    ["怎么装", "好几种装法摆在一起，先得自己挑", "只走一条路：装桌面版，不用开终端"],
    ["接哪个模型", "一长串服务商和模型名", "OpenHands 本身免费。已有别家的 key 或订阅就直接用；什么都没有，再用 OpenHands Cloud 的 key：先充 10 美元，选标着 Free 的模型不扣钱"],
    ["它能碰什么", "文档提醒：代理能访问你整个文件系统", "第一次只让它在一个新建的空文件夹里干活"],
  ],
  lessonsH: "新手只要三课", lessonsP: "按顺序看，大约 30 分钟。学完这三课就能用起来，网站上其他内容都是以后遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: ["有人推荐了 OpenHands，你想试试，可官方文档看得一头雾水", "用过 ChatGPT、Claude 这类聊天 AI，想让 AI 直接动手做事", "愿意花半小时，跟着一步步做一遍"],
  NO: ["只想问问题、写写文字：普通的聊天 AI 就够了", "电脑不是你的、不能装软件：先问问管电脑的人", "想直接拿公司的重要项目开刀：先在空文件夹里练熟，再看完整教程"],
  devH: "会写代码的人看这里",
  devP: "OpenHands 现在的主角是 Agent Canvas（浏览器里的控制台）和 Agent Server（真正跑代理的后台，用 Python SDK 做的）。一个 Canvas 能连好几个后端：你的电脑、Docker、虚拟机，或 OpenHands Cloud。除了自带的 OpenHands 代理，也能通过 ACP 跑 Claude Code、Codex、Gemini CLI。下面是一次对话走过的路，和 9 步的完整教程。",
  FLOW: [
    ["MessageCircle", "你在 Agent Canvas 里交代一件事", "对话、文件、终端、模型设置、自动化，都在这一个界面里。"],
    ["Server", "后端接下这件事", "Agent Server 跑对话和工具。它装在哪台机器上，代理就能碰到哪里的文件。"],
    ["Bot", "代理配上模型开始想", "OpenHands 自带的代理，或者 Claude Code、Codex 这类 ACP 代理，用你接上的模型。"],
    ["FolderOpen", "在工作区里动手", "读写文件、跑命令、开 PR。自动化还能按时间或事件自己开对话。"],
  ],
  CONN: ["交给", "启动", "动手"],
  stepsLabel: (n) => `完整教程：共 ${n} 步`,
};
const EN = {
  brand: "OpenHands for beginners",
  h1: "Someone told you to try OpenHands? Start here",
  lead: ["OpenHands is an open-source AI coding agent. You hand it a task, and it runs the commands, edits the files and opens the PR itself. It can even start work on a schedule. The official docs are written for engineers. This guide walks you through setting it up in plain words, ", "even if you don't code", "."],
  cta: ["Start here if you're new", "I code: the full guide"],
  ctaNote: "The beginner track is three lessons, about 30 minutes.",
  painH: "Stuck here?",
  PAIN: [
    "You open the official docs and see npm, Docker and uv before you know which one to install.",
    "Agent Canvas, Agent Server, backends, ACP, Cloud, SDK: so many names, and no clue which one is for you.",
    "You've heard it edits files and runs commands on its own, and you worry it will mess up the rest of your computer.",
    "You don't know what it costs, or whether you need accounts with a pile of AI companies first.",
  ],
  diffH: "What this guide does differently",
  diffW: "Where you get stuck", diffA: "Reading the official docs alone", diffB: "With this guide",
  DIFF: [
    ["Installing", "Several install options side by side; you pick", "One path: the desktop app, no terminal needed"],
    ["Picking a model", "A long list of providers and model names", "OpenHands itself is free. Already have a key or subscription? Use it. Otherwise one OpenHands Cloud key: a $10 top-up first, and models marked Free don't use it"],
    ["What it can touch", "The docs warn the agent can access your whole filesystem", "The first time, it works only inside a new, empty folder"],
  ],
  lessonsH: "Beginners need just three lessons", lessonsP: "Read them in order, about 30 minutes in all. After these three you can put it to work. Everything else on the site is for looking up later.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: ["Someone recommended OpenHands and the official docs lost you", "You've used a chat AI like ChatGPT or Claude and want an AI that does the work", "You can spare half an hour to follow along step by step"],
  NO: ["You only want to ask questions or write text: a regular chat AI is enough", "The computer isn't yours to install software on: ask whoever runs it first", "You want to start on an important work project: practice in an empty folder first, then read the full guide"],
  devH: "If you write code",
  devP: "Today OpenHands centers on Agent Canvas (the control center in your browser) and the Agent Server (the backend that runs agents, built on the Python SDK). One Canvas can connect to several backends: your machine, Docker, a VM or OpenHands Cloud. Besides the built-in OpenHands agent, it can run Claude Code, Codex or Gemini CLI through ACP. Below is the path one conversation takes, and the 9-step full guide.",
  FLOW: [
    ["MessageCircle", "You hand a task over in Agent Canvas", "Conversations, files, terminals, model settings and automations all live in this one screen."],
    ["Server", "A backend takes the job", "The Agent Server runs the conversation and its tools. Whichever machine it runs on is whose files the agent can reach."],
    ["Bot", "The agent thinks with your model", "The built-in OpenHands agent, or an ACP agent like Claude Code or Codex, using the model you connected."],
    ["FolderOpen", "It works in the workspace", "It reads and writes files, runs commands and opens PRs. Automations can start conversations on a schedule or an event."],
  ],
  CONN: ["hands off", "starts", "acts"],
  stepsLabel: (n) => `Full guide: ${n} steps`,
};
// 其他语言：文字来自 src/i18n/<语言>.js；FLOW 的图标沿用英文版；完整教程链到英文版
const x = dict(lang);
const fl = fullLang(lang);
const C = x
  ? { ...EN, ...x.home, brand: x.ui.brand, FLOW: EN.FLOW.map(([icon], i) => [icon, ...(x.home.FLOW[i] ?? EN.FLOW[i].slice(1))]), stepsLabel: (n) => fmt(x.home.stepsLabel, { n }) }
  : lang === "en" ? EN : ZH;
const headings = [["h-pain", C.painH], ["h-diff", C.diffH], ["h-lessons", C.lessonsH], ["h-fit", C.fitH], ["h-dev", C.devH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], fl)} hreflang={fl === lang ? undefined : fl}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>
    <Demo />

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-diff">
      <h2 id="h-diff">{C.diffH}</h2>
      <div class="xxd-table-wrap diff">
        <table class="xxd-table">
          <thead><tr><th scope="col">{C.diffW}</th><th scope="col" data-wrap>{C.diffA}</th><th scope="col" data-wrap>{C.diffB}</th></tr></thead>
          <tbody>{C.DIFF.map(([w, a, b]) => <tr><th scope="row" class="diff__when">{w}</th><td data-wrap class="diff__before">{a}</td><td data-wrap>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-dev">
      <h2 id="h-dev">{C.devH}</h2>
      <p>{C.devP}</p>
      {x && <p class="home__note">{C.devNote}</p>}
      <div class="flow">
        {C.FLOW.map(([icon, h, p], i) => (
          <>
            {i > 0 && (
              <div class="flow__conn" aria-hidden="true">
                <span class="flow__label">{C.CONN[i - 1]}</span>
                <span class="flow__track"><span class="flow__dot" style={`animation-delay:${(i - 1) * 1.2}s`}></span><i class="flow__head" data-xxd-icon="ChevronRight" data-size="14"></i></span>
              </div>
            )}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{h}</p>
              <p class="flow__desc">{p}</p>
            </div>
          </>
        ))}
      </div>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={C.stepsLabel(STEPS.length)}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={stepHref(s, fl)}>{t(s, "title", fl)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", fl)} · {t(s, "sum", fl)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <Contact />
  </div>
</Site>
